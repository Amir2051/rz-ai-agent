# Local development only. Never commit real credentials.
RZ_API_KEY=replace-with-a-local-rz-api-key
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
# Optional extra models (comma-separated) tried in order when the model above is rate-limited or down.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_ZDR=false
OPENROUTER_ALLOW_FALLBACKS=true

# Cartesia text-to-speech. Save your actual key in .env, not this example file.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=e07c00bc-4134-4eae-9ea4-1a55fb45746b
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_VERSION=2026-08-14

# Optional: retained for realtime speech transcription and temporary TTS fallback.
INWORLD_API_KEY=
INWORLD_VOICE_ID=Ashley
INWORLD_TTS_MODEL=inworld-tts-2

# Optional Firecrawl live web search and public-page extraction. Keep the real key private.
FIRECRAWL_API_KEY=

# Dedicated server-to-server credential for DriveNest marketing integration (keep private).
MIA_RZ_SERVICE_API_KEY=

# Optional Browserbase cloud browser for JavaScript-rendered marketing research. Keep private.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Operator accounts (comma-separated emails) that may use the operator's own resources:
# the server GITHUB_TOKEN and the local terminal bridge. Every other account is blocked.
# Required in account mode (DATABASE_URL set); empty means nobody gets these tools.
RZ_OPERATOR_EMAILS=
# Optional: principal ids that count as operators (an account UUID, or "service" for the RZ_API_KEY service principal).
RZ_OPERATOR_USER_IDS=
